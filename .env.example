# ============================================================
# JARVIS — environment configuration
# Copy this file to `.env` and fill in your own values.
# Anything set later in the in-app Settings panel overrides
# these values, so leaving this file alone is fine too.
# ============================================================

# --- AI provider -------------------------------------------------
# JARVIS supports multiple AI providers. "gemini" is the default
# and does not require any extra setup beyond an API key.
AI_PROVIDER=gemini

# Google Gemini (default provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (optional alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (optional alternative provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Voice (ElevenLabs text-to-speech) ---------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=wDsJlOXPqcvIUKdLXjDs
